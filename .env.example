# ── Administrative access ───────────────────────────────────────
# Required in production. Use a random value with at least 32 characters.
# It is entered in the page's "解锁控制" form and is never a Binance API key.
APP_SECRET=

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:port/database

# ── Mainnet execution (disabled and unconfigured by default) ──
# Required in addition to LIVE_MAINNET, fresh admin authorization and preflight.
LIVE_TRADING_ENABLED=false
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# ── HTTP ───────────────────────────────────────────────────────
PORT=3000
