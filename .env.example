# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:port/database

# ── Mainnet execution (disabled and unconfigured by default) ──
# Required in addition to LIVE_MAINNET, explicit confirmation and preflight.
LIVE_TRADING_ENABLED=false
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
# Comma-separated explicit whitelist; blank fails preflight closed.
BINANCE_MAINNET_ALLOWED_SYMBOLS=

# ── HTTP ───────────────────────────────────────────────────────
PORT=3000
