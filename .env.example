# ── Administrative access ───────────────────────────────────────
# Required in production. Use a random value with at least 32 characters.
# It is entered in the page's "解锁控制" form and is never a Binance API key.
APP_SECRET=

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:port/database

# ── HTTP ───────────────────────────────────────────────────────
PORT=3000
